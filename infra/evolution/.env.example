# Copy to .env and fill in. Never commit .env.
# Generate long random values, e.g.: openssl rand -hex 32

# --- Database: fill in ONE of these two ---
# a) docker-compose.yml (Postgres on this machine): its password.
POSTGRES_PASSWORD=
# b) docker-compose.neon.yml (Neon): the *direct* connection string (not the "pooled" one),
#    ending in ?sslmode=require&schema=public
DATABASE_CONNECTION_URI=

# docker-compose.neon.yml only: the hostname Caddy gets an HTTPS certificate for,
# e.g. 203-0-113-7.sslip.io (the server's public IP with dashes). No https://.
EVOLUTION_DOMAIN=

# Evolution's global API key. Set the same value in Convex as EVOLUTION_API_KEY.
# If unset, Evolution falls back to a public default key, so never leave it empty.
AUTHENTICATION_API_KEY=
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# The public HTTPS address of this server, e.g. https://wa.example.com.
# Set the same value in Convex as EVOLUTION_API_URL.
SERVER_URL=
SERVER_PORT=8080
SERVER_TYPE=http

# Store sessions and new messages (Stallo fetches customers' pictures by message id).
# Contacts, chats and message history are not needed.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

# No Redis.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# Each seller's webhook is set by Stallo per session (signed with EVOLUTION_WEBHOOK_SECRET).
WEBHOOK_GLOBAL_ENABLED=false

# Never delete unlinked sessions automatically; Stallo removes them.
DEL_INSTANCE=false
# How many QR codes one link attempt may show before giving up.
QRCODE_LIMIT=10

# How the linked device appears in the seller's WhatsApp > Linked devices.
CONFIG_SESSION_PHONE_CLIENT=Stallo
CONFIG_SESSION_PHONE_NAME=Chrome

LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error
